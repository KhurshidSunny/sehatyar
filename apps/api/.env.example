# Copy to .env and fill in local values. Never commit real secrets.

# MongoDB Atlas example (replace USER, PASSWORD, CLUSTER host):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sehatyar?retryWrites=true&w=majority&appName=Cluster0
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sehatyar

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# OCR (optional — path to tesseract.exe on Windows if not on PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Content paths (relative to repo root when running from apps/api)
FAQ_DATA_DIR=../../data/faqs
MEDICINE_DATA_DIR=../../data/medicines
